# Server only. Never put DATABASE_URL in EXPO_PUBLIC variables.
PORT=3000
HOST=127.0.0.1
# Optional origin used by the unauthenticated HTTP deployment checks.
AUTOGUARDIAN_API_ORIGIN=http://127.0.0.1:3000
# Temporary email accounts in an isolated development project only.
NODE_ENV=development
ALLOW_DEV_EMAIL_AUTH=true
# Production: NODE_ENV=production and ALLOW_DEV_EMAIL_AUTH=false. Staff then
# require password + TOTP (both within one hour), live Auth session checks and
# current authority grants. Install 018 first; see docs/AGENT-ACCESS-CONSENT.md.
CORS_ORIGIN=http://localhost:8081
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Separate restricted login, created using setup-identity-login.sql.
# Use the connection details supplied by Supabase, with this login's username.
DATABASE_URL=
# Backend chooses the authority. No client-supplied authority/role is accepted.
AUTOGUARDIAN_TENANT_ID=
# Server-only Supabase secret key (sb_secret_...), never a publishable/mobile key.
# Blank keeps development evidence uploads disabled. Use sample files only.
SUPABASE_STORAGE_SECRET_KEY=
# 32 random bytes encoded as 64 hex characters. Preserve it to recover encrypted files.
# Also derives separate keys for encrypted sample owner details and keyed request fingerprints.
# Local setup generates this value; production key management is a separate requirement.
ENROLLMENT_EVIDENCE_KEY_HEX=
# Production uses separate owner/evidence keys and a separate private bucket.
# Generate local test keys: node scripts/prepare-registration-test-config.cjs
# This never enables production or publishes consent. See the setup guide.
PRODUCTION_OWNER_KEY_HEX=
PRODUCTION_EVIDENCE_KEY_HEX=
PRODUCTION_EVIDENCE_BUCKET=registration-enrollment-evidence
# Production seal signing: fill together; absent settings disable issuance/scanned inspection.
# Exact HTTPS origin for the eventual verification site; no path or trailing slash.
AUTOGUARDIAN_SEAL_ORIGIN=
AUTOGUARDIAN_SEAL_ACTIVE_KEY=
# JSON mapping key versions to independent 32-byte random secrets encoded as hex.
# Server only. Retain old versions while their printed labels remain valid.
AUTOGUARDIAN_SEAL_KEYS_JSON=
# Africa's Talking: all sending remains opt-in and restricted to controlled phones.
# Requires migration 027. Use sandbox username exactly 'sandbox'.
AFRICASTALKING_SMS_ENABLED=false
AFRICASTALKING_ENVIRONMENT=sandbox
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_TEST_RECIPIENTS_JSON=[]
AFRICASTALKING_PRODUCTION_APPROVED=false
# 32 random bytes as hex. TRUSTED INGRESS ONLY: strip incoming copies of
# X-AutoGuardian-Gateway-Token, verify provider origin, inject this token.
# This is NOT an Africa's Talking signature. Never expose the API around ingress.
AFRICASTALKING_GATEWAY_TOKEN=
# Requires migration 028 and separate 32-byte key; back up before enabling.
AFRICASTALKING_CHANNELS_ENABLED=false
AFRICASTALKING_SMS_SHORTCODE=
AFRICASTALKING_USSD_SERVICE_CODE=
# Provisional until the operator accepts its text limits (120-512, default 160).
AFRICASTALKING_USSD_MAX_REPLY_CHARS=160
AUTOGUARDIAN_TELECOM_KEY_HEX=
# Supabase Auth remains the OTP/session authority; configure its Send SMS HTTP Hook.
SUPABASE_SMS_HOOK_ENABLED=false
# v1,whsec_<base64 of 32 random bytes>. Optional previous secret separated by |.
SUPABASE_SMS_HOOK_SECRET=
# Optional app owner PIN enrollment/proofs. Requires migration 029, enabled SMS
# and explicit administrator policy. No PIN policy or recovery path is seeded.
OWNER_PIN_ENABLED=false
# Accepted-contact invitations/OTP and vehicle seller mandates. Requires 030.
AUTOGUARDIAN_RELATIONSHIPS_ENABLED=false
# Optional report evidence encryption. Generate 32 random bytes as 64 hex digits.
# Store securely and back up separately; changing this loses old evidence access.
AUTOGUARDIAN_REPORT_EVIDENCE_KEY=
# Optional versioned key ring for safe rotation; retain the legacy key above
# while historical unversioned ciphertext exists. Both fields required together.
AUTOGUARDIAN_REPORT_EVIDENCE_KEYS_JSON=
AUTOGUARDIAN_REPORT_EVIDENCE_ACTIVE_KEY=
CHECK_SWEEP_INTERVAL_MS=10000
# pawaPay sandbox only. Used by pawapay:check and pawapay:test after a build.
# Test money never unlocks production registrations or production benefits.
PAWAPAY_API_TOKEN=
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
# Temporary tunnel URLs are configured locally; restart changes the hostname.
PAWAPAY_CHECKOUT_CALLBACK_URL=
PAWAPAY_DEPOSIT_CALLBACK_URL=
PAWAPAY_PAYOUT_CALLBACK_URL=
PAWAPAY_REFUND_CALLBACK_URL=
# Sandbox pilot billing is opt-in and requires migration 024 and a separate worker.
PILOT_BILLING_SANDBOX_ENABLED=false
PILOT_BILLING_KEY_HEX=
BILLING_DATABASE_URL=
# Enable only after enabling signed callbacks in the pawaPay sandbox dashboard.
PAWAPAY_REQUIRE_SIGNED_CALLBACKS=false
# Live billing remains OFF until business/provider acceptance and policy approval.
PAWAPAY_PRODUCTION_ENABLED=false
PAWAPAY_PRODUCTION_APPROVED=false
PAWAPAY_LIVE_BASE_URL=https://api.pawapay.io
PAWAPAY_LIVE_API_TOKEN=
PAWAPAY_LIVE_BILLING_KEY_HEX=
BILLING_REMINDER_SMS_ENABLED=false
BILLING_REMINDER_SMS_APPROVED=false
