# Server only. Never put DATABASE_URL in EXPO_PUBLIC variables.
PORT=3000
HOST=127.0.0.1
# Temporary email accounts in an isolated development project only.
NODE_ENV=development
ALLOW_DEV_EMAIL_AUTH=true
# Production: NODE_ENV=production and ALLOW_DEV_EMAIL_AUTH=false. Staff then
# require password + TOTP (both within one hour), live Auth session checks and
# current authority grants. Install 018 first; see docs/AGENT-ACCESS-CONSENT.md.
CORS_ORIGIN=http://localhost:8081
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Separate restricted login, created using setup-identity-login.sql.
# Use the connection details supplied by Supabase, with this login's username.
DATABASE_URL=
# Backend chooses the authority. No client-supplied authority/role is accepted.
AUTOGUARDIAN_TENANT_ID=
# Server-only Supabase secret key (sb_secret_...), never a publishable/mobile key.
# Blank keeps development evidence uploads disabled. Use sample files only.
SUPABASE_STORAGE_SECRET_KEY=
# 32 random bytes encoded as 64 hex characters. Preserve it to recover encrypted files.
# Also derives separate keys for encrypted sample owner details and keyed request fingerprints.
# Local setup generates this value; production key management is a separate requirement.
ENROLLMENT_EVIDENCE_KEY_HEX=
# Production uses separate owner/evidence keys and a separate private bucket.
# Generate local test keys: node scripts/prepare-registration-test-config.cjs
# This never enables production or publishes consent. See the setup guide.
PRODUCTION_OWNER_KEY_HEX=
PRODUCTION_EVIDENCE_KEY_HEX=
PRODUCTION_EVIDENCE_BUCKET=registration-enrollment-evidence
# Production seal signing: fill together; absent settings disable issuance/scanned inspection.
# Exact HTTPS origin for the eventual verification site; no path or trailing slash.
AUTOGUARDIAN_SEAL_ORIGIN=
AUTOGUARDIAN_SEAL_ACTIVE_KEY=
# JSON mapping key versions to independent 32-byte random secrets encoded as hex.
# Server only. Retain old versions while their printed labels remain valid.
AUTOGUARDIAN_SEAL_KEYS_JSON=
# Operational SMS only; Supabase Auth OTP is configured separately in module 3.
# Disabled until the developer's Twilio account/sender and HTTPS callback exist.
TWILIO_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional old token during a same-account Auth Token rotation.
TWILIO_PREVIOUS_AUTH_TOKEN=
# Set exactly one sender: an E.164 SMS-capable number OR a Messaging Service SID.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Exact public HTTPS URL, no trailing slash or query. Local API needs an HTTPS tunnel.
TWILIO_STATUS_CALLBACK_BASE_URL=
# Only explicit test destinations; fill locally, never commit real phone numbers.
TWILIO_SAMPLE_RECIPIENTS_JSON=[]
# Optional report evidence encryption. Generate 32 random bytes as 64 hex digits.
# Store securely and back up separately; changing this loses old evidence access.
AUTOGUARDIAN_REPORT_EVIDENCE_KEY=
CHECK_SWEEP_INTERVAL_MS=10000
