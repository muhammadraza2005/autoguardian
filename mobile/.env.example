# All EXPO_PUBLIC values are embedded in the client. Never place secrets here.
# Demo mode works only in development; release bundles always use live mode.
EXPO_PUBLIC_APP_MODE=demo
# Temporary real email login: APP_MODE=live plus this flag, in development only.
EXPO_PUBLIC_DEV_EMAIL_AUTH=false
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
